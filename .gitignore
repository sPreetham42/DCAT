# SpamAssassin corpus: public tarball archives plus the extracted copies.
# Re-downloaded on demand by scripts/profile_spamassassin.py — never commit.
# (Authoritative derived data lives in data/manifests/ and data/experiments/,
#  which are intentionally NOT ignored.)
data/spamassassin/

*.parquet
*.arrow
*.db
*.sqlite
*.sqlite3


# ─────────────────────────────────────────────────────────────────────────────
# DCAT environment variables (copy to .env and fill in).
#
# No raw/personal email data is ever committed to Git. These variables let the
# config resolution point at data living outside the repository.
# ─────────────────────────────────────────────────────────────────────────────

# Root directory containing raw .eml files.
DATASET_RAW_DIR=data/raw

# Directory for processed/normalized records (Parquet).
DATASET_PROCESSED_DIR=data/processed

# Path to the dataset manifest (labels + splits).
DATASET_MANIFEST=data/manifests/manifest.csv

# MLflow tracking URI.
MLFLOW_TRACKING_URI=mlruns
